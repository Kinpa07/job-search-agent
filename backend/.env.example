# Database (Module 1+)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/jobsearch
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5433/jobsearch

# Redis (Module 2+)
REDIS_URL=redis://localhost:6379/0

# Claude API (Module 3+)
ANTHROPIC_API_KEY=sk-ant-...

# LangSmith tracing (Module 3+, Standing Rule 7)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=job-search-agent
# EU-region workspaces MUST override this, or trace ingestion returns 403:
# LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Email (Module 6+)
RESEND_API_KEY=re_...

# Auth (Module 10+)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Deployment (Module 12+)
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
